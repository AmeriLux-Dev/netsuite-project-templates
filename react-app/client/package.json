{
  "name": "{{appNameKebab}}-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React single-page app for {{appTitle}}, served by a Suitelet.",
  "scripts": {
    "dev": "concurrently -k -n vite,proxy \"vite\" \"tsx server.ts\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.34",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.37",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^5.0.0"
  }
}
