    "nspSpecification": {
        "scope": "typescript",
        "prefix": [
            "nspSpecification",
            "nspSpec"
        ],
        "description": "api/src/specifications/<set>Specifications.ts with one builder per kind of condition (=, IN, a date comparison, BETWEEN, LIKE, null, an OR group, a line field, a formula), plus include, an order and a page; keep what the repositories need and delete the rest. The model name is inferred from the file name; type over it if the guess is wrong.",
        "body": [
            "import type { Specification } from '@amerilux/netsuite-repository';",
            "import { type ${1:${TM_FILENAME_BASE/^(.)|(ies)Specifications$|(ss|x|z|ch|sh)esSpecifications$|s?Specifications$/${1:/upcase}${2:+y}$3/g}}, ${1}Fields as Fields } from '../repositories/generated/${1}.gen';",
            "",
            "/**",
            " * The query vocabulary for ${2:the subject}: one condition per builder, and no decisions. A repository function",
            " * composes them, in order, into one query, and a field path the model lacks is a compile error here rather than a",
            " * failed query in NetSuite. Each kind of condition is here once: keep what the repositories need and delete the rest.",
            " */",
            "",
            "/** Equality. Consecutive conditions are ANDed, and an undefined value skips the condition. */",
            "export const for${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/} = (${3:customerId}: number): Specification<${1}> =>",
            "    (query) => query.where(Fields.${3}, '=', ${3});",
            "",
            "/** IN, skipped when the list is empty; whereNotIn is the opposite. */",
            "export const withIds = (ids: number[]): Specification<${1}> =>",
            "    (query) => query.whereIn(Fields.id, ids);",
            "",
            "/** A date compares with a Date: `<` becomes N/query's BEFORE. N/query's own operator names work too (ON_OR_AFTER, WITHIN). */",
            "export const datedBefore = (cutoff: Date): Specification<${1}> =>",
            "    (query) => query.where(Fields.${4:tranDate}, '<', cutoff);",
            "",
            "/** BETWEEN, skipped when either end is undefined. */",
            "export const datedBetween = (from: Date | undefined, to: Date | undefined): Specification<${1}> =>",
            "    (query) => query.whereBetween(Fields.${4}, from, to);",
            "",
            "/** Text: LIKE takes % for any run of characters; START_WITH and CONTAIN are N/query's names for the common cases. */",
            "export const with${5/^(.)/${1:/upcase}/}Like = (pattern: string): Specification<${1}> =>",
            "    (query) => query.where(Fields.${5:tranId}, 'LIKE', pattern);",
            "",
            "/** No value at all; whereNotNull is the opposite. */",
            "export const without${6/^(.)/${1:/upcase}/} = (): Specification<${1}> =>",
            "    (query) => query.whereNull(Fields.${6:memo});",
            "",
            "/** OR: a group is one parenthesized condition, and orWhere joins a condition to the one before it. */",
            "export const for${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}OrDatedBefore = (${3}: number, cutoff: Date): Specification<${1}> =>",
            "    (query) => query.whereGroup((group) => group.where(Fields.${3}, '=', ${3}).orWhere(Fields.${4}, '<', cutoff));",
            "",
            "/**",
            " * A condition on a line field narrows the lines, and a sublist is joined inner, so only the records with such a line",
            " * come back, each carrying those lines only.",
            " */",
            "export const withLinesOver = (quantity: number): Specification<${1}> =>",
            "    (query) => query.where(Fields.lines.quantity, '>', quantity);",
            "",
            "/** An N/query formula, for what the model does not declare. The values are part of the text: never build one from input. */",
            "export const datedInLastThirtyDays = (): Specification<${1}> =>",
            "    (query) => query.whereFormula('{trandate} >= SYSDATE - 30');",
            "",
            "/** A reference, subrecord or sublist left out of the default select is read for this query; exclude() leaves one out. */",
            "export const with${7/^(.)/${1:/upcase}/} = (): Specification<${1}> =>",
            "    (query) => query.include('${7:customer}');",
            "",
            "/** Order: orderByAsc, orderByDesc, or orderBy(field, 'ASC' | 'DESC'); each call sorts after the ones before it. */",
            "export const newestFirst = (): Specification<${1}> =>",
            "    (query) => query.orderByDesc(Fields.${4});",
            "",
            "/** One page of the rows, the first page being 1; limit() and offset() say the same in two calls. */",
            "export const onPage = (pageNumber: number, pageSize: number): Specification<${1}> =>",
            "    (query) => query.page(pageNumber, pageSize);",
            ""
        ]
    },
