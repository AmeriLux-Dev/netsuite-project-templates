    "nspModel": {
        "scope": "typescript",
        "prefix": "nspModel",
        "description": "api/src/models/<Record>.ts with every decorator and option once, each commented, and a subrecord class and a sublist line class in the same file; keep what the record needs, delete the rest and trim the import. NetsuiteRecordType lists the native record types; a custom record uses its id string. Then npm run generate.",
        "body": [
            "import { ExcludeFromDefaultSelect, Field, InternalId, NetsuiteRecordType, NotMapped, ParentId, ReadOnly, RecordType, Reference, SetFirst, Sublist, Subrecord, Transform } from '@amerilux/netsuite-repository';",
            "import type { ${1:Customer} } from './${1}';",
            "",
            "/**",
            " * ${TM_FILENAME_BASE}: ${9:what one record is}. Every decorator and option is here once: keep what the record needs,",
            " * delete the rest, and trim the import to match. Three rules cover most of a model. Every declared property is a",
            " * mapped field (@NotMapped opts out). Every body field is writable (@ReadOnly opts out); its field id is the",
            " * lowercased property name, and @Field renames it. A property typed as another model class is a reference, a",
            " * subrecord or a sublist, and the join comes from the declared type. The record's type and field ids are declared",
            " * here and nowhere else. Run `npm run generate` after editing: it refreshes api/src/repositories/generated/ and",
            " * api/src/types/models.gen.ts.",
            " */",
            "",
            "/** A transform runs on every value read. It must be an exported function: the build step imports it by name. */",
            "export function ${2:trimText}(value: unknown): string {",
            "    return String(value ?? '').trim();",
            "}",
            "",
            "/**",
            " * A subrecord is a plain class without @RecordType; the field id comes from the property that uses it. A subrecord",
            " * with a table of its own carries @RecordType and its own @InternalId(), and the property then says @Subrecord().",
            " */",
            "export class ${TM_FILENAME_BASE}Address {",
            "    addr1!: string | null;",
            "",
            "    city!: string | null;",
            "",
            "    /** Written before the other fields of the subrecord, because NetSuite recomputes dependants when it changes. */",
            "    @SetFirst()",
            "    state!: string | null;",
            "",
            "    zip!: string | null;",
            "}",
            "",
            "/**",
            " * A sublist line is a record type like any other, usually in a file of its own; what differs is the key (`line`,",
            " * queried as `id`) and @ParentId(), the field N/query joins the lines through.",
            " */",
            "@RecordType('${3:transactionline}')",
            "export class ${TM_FILENAME_BASE}Line {",
            "    /** The internal id when it is not the property `id`: queried as `id`, written through the sublist field `line`. */",
            "    @InternalId()",
            "    @Field('line', { queryFieldId: 'id' })",
            "    lineId!: number;",
            "",
            "    @ParentId()",
            "    @Field('transaction')",
            "    @ReadOnly()",
            "    ${TM_FILENAME_BASE/^(.)/${1:/downcase}/}Id!: number;",
            "",
            "    @Field('item')",
            "    itemId!: number;",
            "",
            "    quantity!: number;",
            "",
            "    @ReadOnly()",
            "    amount!: number;",
            "}",
            "",
            "@RecordType(${4:NetsuiteRecordType.SALES_ORDER}, {",
            "    // queryType: 'transaction',   the N/query root when it is not the record type",
            "    // filter: [{ fieldId: 'mainline', operator: 'IS', values: [true] }],   conditions applied to every query",
            "    // setName: 'documents',   the set on dbContext; the default is the pluralized class name",
            "    // coerce: true,   convert what every query answers to the declared types",
            "    // updater: { ... },   default RecordUpdaterOptions for every write",
            "})",
            "export class ${TM_FILENAME_BASE} {",
            "    /** The internal id: the property `id`, read-only, by convention. */",
            "    id!: number;",
            "",
            "    /** @Field renames a field whose id is not the lowercased property name. */",
            "    @Field('tranid')",
            "    tranId!: string;",
            "",
            "    /** The type comes from the property: string, number, boolean, Date; string[] or number[] for a multiselect. */",
            "    tranDate!: Date;",
            "",
            "    memo!: string | null;",
            "",
            "    /**",
            "     * @Field's type says what the property's type cannot: 'string', 'integer', 'float', 'currency', 'boolean',",
            "     * 'checkbox', 'date', 'datetime', 'select', 'multiselect' or 'key'. A select field with no reference behind it",
            "     * says 'select': N/query compares select and key fields through ANY_OF and rejects EQUAL on them.",
            "     */",
            "    @Field('salesrep', { type: 'select' })",
            "    salesRepId!: number | null;",
            "",
            "    /** coerce converts what the query answers to the declared type, for this field only; @RecordType's coerce does every field. */",
            "    @Field('custbody_priority', { type: 'integer', coerce: true })",
            "    priority!: number | null;",
            "",
            "    /** Queried under one field id, written under another. */",
            "    @Field('orderstatus', { queryFieldId: 'status' })",
            "    status!: string;",
            "",
            "    /** The display text of a select field, read-only; the select field itself is the property above. */",
            "    @Field({ queryFieldId: 'status', text: true })",
            "    statusText!: string;",
            "",
            "    /** The select field behind a reference, named `<reference>Id` so the reference below needs no decorator. */",
            "    @Field('${5:entity}')",
            "    ${6:customer}Id!: number;",
            "",
            "    /**",
            "     * A reference: a property typed as another model, and the Pick is the projection, so only those fields are read.",
            "     * A reference is read-only; to change it, write the select field. @Reference() is needed only to name another",
            "     * select property, a targetKey on the target other than its internal id, or load: 'separate' for a join N/query",
            "     * lacks.",
            "     */",
            "    @Reference('${6}Id', { load: 'join' })",
            "    ${6}?: Pick<${1}, '${7:id}' | '${8:companyName}'>;",
            "",
            "    /** Excluded from writes. */",
            "    @Field('foreigntotal')",
            "    @ReadOnly()",
            "    total!: number;",
            "",
            "    /** Left out of the default select; include() brings it back for one query. */",
            "    @ExcludeFromDefaultSelect()",
            "    @Field('custbody_notes')",
            "    notes!: string | null;",
            "",
            "    /** Transformed on every read. */",
            "    @Transform(${2})",
            "    @Field('otherrefnum')",
            "    poNumber!: string | null;",
            "",
            "    /** Not a field: stays on the type for a value filled in after the query. */",
            "    @NotMapped()",
            "    displayLabel?: string;",
            "",
            "    /** A subrecord; clearListField names the list field cleared before an edit, and load: 'separate' reads it in a query of its own. */",
            "    @Subrecord({ clearListField: 'shipaddresslist' })",
            "    shippingAddress!: ${TM_FILENAME_BASE}Address;",
            "",
            "    /** The lines, reached from the transaction root through transactionlines, without the header line; load: 'separate' reads them in a query of their own. */",
            "    @Sublist('item', { queryType: 'transaction', relationship: 'transactionlines', filter: [{ fieldId: 'mainline', operator: 'IS', values: [false] }] })",
            "    lines!: ${TM_FILENAME_BASE}Line[];",
            "}",
            ""
        ]
    },
