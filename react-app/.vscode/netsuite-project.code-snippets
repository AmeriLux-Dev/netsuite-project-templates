        "description": "api/src/repositories/<set>Repository.ts over dbContext, with every read the set offers (list, first, find, getById, count, exists) and every write through withTracking() (create, update, a sublist patch, delete, several records saved at once), each write logged; keep what the services need and delete the rest. Set and model names come from the file name. Next: nspTestRepository.",
        "body": [
            "import * as log from 'N/log';",
            "import type { ${1:${TM_FILENAME_BASE/^(.)|(ies)Repository$|(ss|x|z|ch|sh)esRepository$|s?Repository$/${1:/upcase}${2:+y}$3/g}}, ${1}Create, ${1}Patch } from '../types/models.gen';",
            "import { dbContext } from './generated/context.gen';",
            "import { datedBefore, for${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}, newestFirst } from '../specifications/${2:${TM_FILENAME_BASE/(.*)Repository$/$1/}}Specifications';",
            "",
            "/**",
            " * Data access for ${5:the subject}: sentences built from the specifications over dbContext. Every read and write the",
            " * record set offers is here once: keep what the services need and delete the rest. A read goes through",
            " * `dbContext.${2}` and tracks nothing. A write asks `dbContext.withTracking()` for a tracker of its own and finishes",
            " * before the function returns, so no tracked record outlives the call that changed it.",
            " */",
            "",
            "/** Every one for the ${3/^(.)(.*?)(Id)?$/${1:/downcase}$2/}, newest first: list() applies the specifications in order, as one query. */",
            "export function list${2/^(.)/${1:/upcase}/}By${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}(${3:customerId}: number): ${1}[] {",
            "    return dbContext.${2}.list(for${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}(${3}), newestFirst());",
            "}",
            "",
            "/** The newest one for the ${3/^(.)(.*?)(Id)?$/${1:/downcase}$2/}, or null when there is none: first() stops at one row. */",
            "export function findNewest${1}By${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}(${3}: number): ${1} | null {",
            "    return dbContext.${2}.first(for${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}(${3}), newestFirst());",
            "}",
            "",
            "/** One by its internal id, or null when none has it. */",
            "export function find${1}(id: number): ${1} | null {",
            "    return dbContext.${2}.find(id);",
            "}",
            "",
            "/** One by its internal id; getById() throws RecordNotFoundError when none has it, where find() answers null. */",
            "export function read${1}(id: number): ${1} {",
            "    return dbContext.${2}.getById(id);",
            "}",
            "",
            "/** How many the ${3/^(.)(.*?)(Id)?$/${1:/downcase}$2/} has: NetSuite counts them, and nothing is read. */",
            "export function count${2/^(.)/${1:/upcase}/}By${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}(${3}: number): number {",
            "    return dbContext.${2}.count(for${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}(${3}));",
            "}",
            "",
            "/** Whether any is dated before the cutoff: exists() reads one row at most. */",
            "export function has${2/^(.)/${1:/upcase}/}DatedBefore(cutoff: Date): boolean {",
            "    return dbContext.${2}.exists(datedBefore(cutoff));",
            "}",
            "",
            "/** Creates one and answers it with its new id. Throws SaveChangesError when NetSuite refuses the save. */",
            "export function create${1}(fields: ${1}Create): ${1} {",
            "    const created = dbContext.withTracking().${2}.create(fields);",
            "    log.audit('record created', { recordType: dbContext.${2}.recordType, id: created.id });",
            "    return created;",
            "}",
            "",
            "/**",
            " * Changes the fields the patch names, and clears those it sets to null. Body fields alone are one submitFields call;",
            " * a sublist or subrecord change loads the record, changes it and saves it. Throws RecordNotFoundError for an id that",
            " * is not there, and SaveChangesError when NetSuite refuses the save.",
            " */",
            "export function update${1}(id: number, patch: ${1}Patch): ${1} {",
            "    const updated = dbContext.withTracking().${2}.update(id, patch);",
            "    log.audit('record updated', { recordType: dbContext.${2}.recordType, id });",
            "    return updated;",
            "}",
            "",
            "/** A sublist patch takes { update, add, remove }; a line to update or remove is named by its key. */",
            "export function update${1}LineQuantities(id: number, lines: Array<{ lineId: number; quantity: number }>): ${1} {",
            "    return dbContext.withTracking().${2}.update(id, { lines: { update: lines } });",
