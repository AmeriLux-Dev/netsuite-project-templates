    "nspUserEvent": {
        "scope": "typescript",
        "prefix": "nspUserEvent",
        "description": "api/src/events/user/<subject>.ts: a self-contained user event with beforeLoad, beforeSubmit and afterSubmit; keep the ones it needs. Reads and writes the record its context carries; anything else in NetSuite goes through a repository. Create its script record and deployments in NetSuite yourself.",
        "body": [
            "/**",
            " * @NApiVersion 2.1",
            " * @NScriptType UserEventScript",
            " * @NModuleScope SameAccount",
            " */",
            "",
            "import * as log from 'N/log';",
            "import type { EntryPoints } from 'N/types';",
            "import { describeErrorMessage } from '../../lib/errors';",
            "import { ${4:readSomethingRelated} } from '../../repositories/${5:subject}Repository';",
            "",
            "/**",
            " * ${6:What this does and when}. Every entry point a user event has is here once: keep the ones it needs and delete",
            " * the rest. Self-contained on purpose: it belongs to the record, not to this application, so it works the record its",
            " * context carries and reaches anything else through a repository function. It never blocks a save for something that",
            " * is not the user's doing: the work is in a try/catch that logs.",
            " *",
            " * Deployed by hand: create the script record and its deployments in NetSuite (record type ${1:Sales Order}, the",
            " * contexts it should run in), pointing at /SuiteScripts/{{appName}}/api/events/user/${TM_FILENAME_BASE}.js.",
            " */",
            "",
            "/** The ids this event works with, written here because the event is its own. */",
            "const fields = {",
            "    ${2:memo}: '${3:memo}',",
            "} as const;",
            "",
            "/**",
            " * Before the record is shown, in view, edit, create or copy: `context.form` is the page NetSuite is about to draw,",
            " * and it can still change. Here: the client event beside this file becomes the form's page script.",
            " */",
            "export const beforeLoad: EntryPoints.UserEvent.beforeLoad = (context: EntryPoints.UserEvent.beforeLoadContext): void => {",
            "    if (context.type !== context.UserEventType.CREATE && context.type !== context.UserEventType.EDIT) return;",
            "    context.form.clientScriptModulePath = '../client/${TM_FILENAME_BASE}.js';",
            "};",
            "",
            "/** Before the save: `context.newRecord` can still change, and `context.oldRecord` is what it was (null on create). */",
            "export const beforeSubmit: EntryPoints.UserEvent.beforeSubmit = (context: EntryPoints.UserEvent.beforeSubmitContext): void => {",
            "    if (context.type !== context.UserEventType.CREATE && context.type !== context.UserEventType.EDIT) return;",
            "    try {",
            "        const related = ${4}(Number(context.newRecord.id));",
            "        context.newRecord.setValue({ fieldId: fields.${2}, value: String(related) });",
            "        log.debug('event applied', { record: context.newRecord.type, id: context.newRecord.id });",
            "    } catch (error) {",
            "        log.error('event failed', { record: context.newRecord.type, id: context.newRecord.id, message: describeErrorMessage(error) });",
            "    }",
            "};",
            "",
            "/** After the save: the record has its id, and nothing done here can stop the save any more. */",
            "export const afterSubmit: EntryPoints.UserEvent.afterSubmit = (context: EntryPoints.UserEvent.afterSubmitContext): void => {",
            "    if (context.type === context.UserEventType.DELETE) return;",
            "    const before = context.oldRecord?.getValue({ fieldId: fields.${2} });",
            "    const after = context.newRecord.getValue({ fieldId: fields.${2} });",
            "    if (before !== after) log.audit('field changed', { record: context.newRecord.type, id: context.newRecord.id, field: fields.${2} });",
            "};",
            ""
        ]
    },
    "nspClientEvent": {
        "scope": "typescript",
        "prefix": "nspClientEvent",
        "description": "api/src/events/client/<subject>.ts: a client script with every entry point (pageInit through saveRecord, and the localization pair); keep the ones it needs. Runs in the browser with N/* and console; no telemetry and no part of this application. Attach it in NetSuite (a deployment, or a user event's beforeLoad).",
        "body": [
            "/**",
            " * @NApiVersion 2.1",
            " * @NScriptType ClientScript",
            " * @NModuleScope SameAccount",
            " */",
            "",
            "import * as dialog from 'N/ui/dialog';",
            "import type { EntryPoints } from 'N/types';",
            "",
            "/**",
            " * ${4:What this does on the page}. Every entry point a client script has is here once: keep the ones it needs and",
            " * delete the rest. A page script: it runs in the browser on a ${1:sales order} form, so it calls N/* itself and logs",
            " * with console. Nothing of this application belongs here. Every context carries `currentRecord`, the record on the",
            " * page; a validate entry point answers false to refuse, and tells the user why.",
            " *",
            " * Attached by hand: deploy it to the record type in NetSuite, or set it as the form's client script from a user",
            " * event's beforeLoad, pointing at /SuiteScripts/{{appName}}/api/events/client/${TM_FILENAME_BASE}.js.",
            " */",
            "",
            "const fields = {",
            "    ${2:quantity}: '${3:quantity}',",
            "    item: 'item',",
            "    memo: 'memo',",
            "} as const;",
            "",
            "const sublists = {",
            "    item: 'item',",
            "} as const;",
            "",
            "/** Once the page has loaded; `context.mode` is create, copy or edit. */",
            "export const pageInit: EntryPoints.Client.pageInit = (context: EntryPoints.Client.pageInitContext): void => {",
            "    if (context.mode === 'copy') context.currentRecord.setValue({ fieldId: fields.memo, value: '' });",
            "};",
            "",
            "/** After a field changed, on the body (`sublistId` null) or on the current line of a sublist. */",
            "export const fieldChanged: EntryPoints.Client.fieldChanged = (context: EntryPoints.Client.fieldChangedContext): void => {",
            "    if (context.sublistId !== sublists.item || context.fieldId !== fields.${2}) return;",
            "    const value = Number(context.currentRecord.getCurrentSublistValue({ sublistId: sublists.item, fieldId: fields.${2} }));",
            "    if (Number.isNaN(value) || value <= 0) console.warn(fields.${2} + ' is not a positive number');",
            "};",
            "",
            "/** After NetSuite has sourced the fields that depend on the one that changed (an item's price, a customer's terms). */",
            "export const postSourcing: EntryPoints.Client.postSourcing = (context: EntryPoints.Client.postSourcingContext): void => {",
            "    if (context.sublistId !== sublists.item || context.fieldId !== fields.item) return;",
            "    context.currentRecord.setCurrentSublistValue({ sublistId: sublists.item, fieldId: fields.${2}, value: 1 });",
            "};",
            "",
            "/** When a line is selected or a new one is started. */",
            "export const lineInit: EntryPoints.Client.lineInit = (context: EntryPoints.Client.lineInitContext): void => {",
            "    console.info('line selected', context.sublistId);",
            "};",
            "",
            "/** After a line was committed, inserted or removed; `context.operation` says which. */",
            "export const sublistChanged: EntryPoints.Client.sublistChanged = (context: EntryPoints.Client.sublistChangedContext): void => {",
            "    console.info('lines changed', context.sublistId, context.operation);",
            "};",
            "",
            "/** Before a changed field is accepted; false keeps the cursor in it. */",
            "export const validateField: EntryPoints.Client.validateField = (context: EntryPoints.Client.validateFieldContext): boolean => {",
            "    if (context.sublistId !== sublists.item || context.fieldId !== fields.${2}) return true;",
            "    const value = Number(context.currentRecord.getCurrentSublistValue({ sublistId: sublists.item, fieldId: fields.${2} }));",
            "    if (value > 0) return true;",
            "    void dialog.alert({ title: 'Check the line', message: 'The ' + fields.${2} + ' must be a positive number.' });",
            "    return false;",
            "};",
            "",
            "/** Before the current line is committed; false keeps it open. */",
            "export const validateLine: EntryPoints.Client.validateLine = (context: EntryPoints.Client.validateLineContext): boolean => {",
            "    if (context.sublistId !== sublists.item) return true;",
            "    return Boolean(context.currentRecord.getCurrentSublistValue({ sublistId: sublists.item, fieldId: fields.item }));",
            "};",
            "",
            "/** Before a line is inserted between two others; false refuses it. */",
            "export const validateInsert: EntryPoints.Client.validateInsert = (context: EntryPoints.Client.validateInsertContext): boolean =>",
            "    context.sublistId === sublists.item;",
            "",
            "/** Before a line is removed; false keeps it. */",
            "export const validateDelete: EntryPoints.Client.validateDelete = (context: EntryPoints.Client.validateDeleteContext): boolean =>",
            "    context.sublistId !== sublists.item || context.lineCount > 1;",
            "",
            "/** Before the record is saved; false stops the save. */",
            "export const saveRecord: EntryPoints.Client.saveRecord = (context: EntryPoints.Client.saveRecordContext): boolean => {",
            "    if (context.currentRecord.getLineCount({ sublistId: sublists.item }) > 0) return true;",
            "    void dialog.alert({ title: 'Nothing to save', message: 'Add a line first.' });",
            "    return false;",
            "};",
            "",
            "/** When the page's localization context is entered or left, as the subsidiary or address country changes. */",
            "export const localizationContextEnter: EntryPoints.Client.localizationContextEnter = (context: EntryPoints.Client.localizationContext): void => {",
            "    console.info('localization entered', context.locale);",
            "};",
            "",
            "export const localizationContextExit: EntryPoints.Client.localizationContextExit = (context: EntryPoints.Client.localizationContext): void => {",
            "    console.info('localization left', context.locale);",
            "};",
            ""
        ]
    },
