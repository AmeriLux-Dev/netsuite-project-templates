            "// The path comes from the file name: orders.tsx is /orders, orders.\\$${2}.tsx is /orders/\\$${2}, index.tsx is /. The",
            "// route owns the URL and the page owns the screen: a path parameter is read here and handed over typed. For a route",
            "// without one, `component: ${1}` is the whole route.",
            "export const Route = createFileRoute('${TM_FILENAME_BASE/^index$|^|\\./\\//g}')({",
            "    component: function ${1/Page$//}Route() {",
            "        const { ${2:${TM_FILENAME_BASE/^[^$]*\\$?([^.]*).*$/$1/}} } = Route.useParams();",
            "        return <${1} ${2}={Number(${2})} />;",
            "    },",
            "});",
            ""
        ]
    },
