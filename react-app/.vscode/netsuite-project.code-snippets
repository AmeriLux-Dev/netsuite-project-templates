            "    log.audit('record removed', { recordType: dbContext.${2}.recordType, id });",
            "}",
            "",
            "/**",
            " * Several records under one tracker: read through it, change what it answered, and save once. saveChanges() never",
            " * throws; it answers an outcome per record, so a flow that must fail loudly reads it.",
            " */",
            "export function update${2/^(.)/${1:/upcase}/}${4/^(.)/${1:/upcase}/}By${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}(${3}: number, ${4:memo}: string | null): void {",
            "    const tracked = dbContext.withTracking();",
            "    for (const record of tracked.${2}.list(for${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}(${3}))) record.${4} = ${4};",
