{{#if netsuiteApi}}
    "nspControllerRestlet": {
        "scope": "typescript",
        "prefix": "nspControllerRestlet",
        "description": "api/src/controllers/<name>Controller.ts as a Restlet, with every kind of endpoint (a filtered list, byId, create, update, remove), a guard for what comes off the wire and authorize; keep what the controller needs and delete the rest. Name and ids come from the file name. The service it calls is the domain's, singular (salesOrderService for a sales order), which need not match the controller's name: tab to it. Next: nspObjectRestlet in netsuite/Objects, npm run generate, then nspHookQuery.",
        "body": [
            "/**",
            " * @NApiVersion 2.1",
            " * @NScriptType Restlet",
            " * @NModuleScope SameAccount",
            " */",
            "",
            "import { ApiError, defineEndpoints, defineRestlet } from '@amerilux/netsuite-api/server';",
            "import { create${2}, get${2}sBy${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}, get${2}, isSalesRepOf${2}, remove${2}, update${2}${4/^(.)/${1:/upcase}/}, type ${2:${TM_FILENAME_BASE/^(.)(.*?)s?Controller$/${1:/upcase}$2/}}Summary } from '../services/${1:${TM_FILENAME_BASE/^(.*?)s?Controller$/$1/}}Service';",
            "",
            "/**",
            " * The ${TM_FILENAME_BASE/(.*)Controller$/$1/} controller: ${5:what it serves}. Each kind of endpoint is here once, with a guard for what",
            " * comes off the wire and authorize: keep what the controller needs and delete the rest. The shapes are the wire, not",
            " * the record: one request and one response per endpoint, named without the controller's name and all exported, since",
            " * `npm run generate` copies them into the client. An endpoint unpacks the request, calls a service with plain",
            " * arguments and shapes the reply field by field, so a field added to a service's type later does not reach the wire",
            " * unasked.",
            " */",
            "",
            "export interface By${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}Request {",
            "    ${3:customerId}: number;",
            "}",
            "",
            "export interface By${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}Response {",
            "    ${3}: number;",
            "    ${TM_FILENAME_BASE/(.*)Controller$/$1/}: ${2}Summary[];",
            "}",
            "",
            "export interface ByIdRequest {",
            "    id: number;",
            "}",
            "",
            "export interface ByIdResponse {",
            "    ${2/^(.)/${1:/downcase}/}: ${2}Summary;",
            "}",
            "",
            "export interface CreateRequest {",
            "    ${3}: number;",
            "    ${4:memo}: string;",
            "}",
            "",
            "export interface CreateResponse {",
            "    ${2/^(.)/${1:/downcase}/}: ${2}Summary;",
            "}",
            "",
            "export interface UpdateRequest {",
            "    id: number;",
            "    ${4}: string;",
            "}",
            "",
            "export interface UpdateResponse {",
            "    ${2/^(.)/${1:/downcase}/}: ${2}Summary;",
            "}",
            "",
            "export interface RemoveRequest {",
            "    id: number;",
            "}",
            "",
            "export interface RemoveResponse {",
            "    id: number;",
            "}",
            "",
            "/** The wire promises a number; a caller that sends anything else gets a 400, not a query for NaN. */",
            "function parseId(requested: unknown, field: string): number {",
            "    const parsed = typeof requested === 'string' ? Number.parseInt(requested, 10) : requested;",
            "    if (typeof parsed !== 'number' || !Number.isInteger(parsed) || parsed <= 0) {",
            "        throw ApiError.badRequest(`\\${field} must be a positive whole number.`, { [field]: requested });",
            "    }",
            "    return parsed;",
            "}",
            "",
            "/** The wire promises text; anything else is a 400. */",
            "function parse${4/^(.)/${1:/upcase}/}(requested: unknown): string {",
            "    if (typeof requested !== 'string') throw ApiError.badRequest('${4} must be text.', { ${4}: requested });",
            "    return requested;",
            "}",
            "",
            "export const ${TM_FILENAME_BASE/(.*)Controller$/$1/}Endpoints = defineEndpoints({",
            "    /** Every one for the ${3/^(.)(.*?)(Id)?$/${1:/downcase}$2/}; 400 for an id that is not a positive whole number. */",
            "    by${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}: (request: By${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}Request): By${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}Response => {",
            "        const ${3} = parseId(request.${3}, '${3}');",
            "        return { ${3}, ${TM_FILENAME_BASE/(.*)Controller$/$1/}: get${2}sBy${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}(${3}) };",
            "    },",
            "",
            "    /** One by its id; 404 when there is none. */",
            "    byId: (request: ByIdRequest): ByIdResponse => {",
            "        const id = parseId(request.id, 'id');",
            "        const ${2/^(.)/${1:/downcase}/} = get${2}(id);",
            "        // \"None\" is the service's answer; which HTTP status that is belongs to the wire, so here.",
            "        if (${2/^(.)/${1:/downcase}/} === null) throw ApiError.notFound('No record has that id.', { id });",
            "        return { ${2/^(.)/${1:/downcase}/} };",
            "    },",
            "",
            "    /** Creates one and answers it with its new id. */",
            "    create: (request: CreateRequest): CreateResponse => {",
            "        const ${3} = parseId(request.${3}, '${3}');",
            "        return { ${2/^(.)/${1:/downcase}/}: create${2}(${3}, parse${4/^(.)/${1:/upcase}/}(request.${4})) };",
            "    },",
            "",
            "    /** Replaces the ${4}; 404 when there is no such record. */",
            "    update: (request: UpdateRequest): UpdateResponse => {",
            "        const id = parseId(request.id, 'id');",
            "        const ${2/^(.)/${1:/downcase}/} = update${2}${4/^(.)/${1:/upcase}/}(id, parse${4/^(.)/${1:/upcase}/}(request.${4}));",
            "        if (${2/^(.)/${1:/downcase}/} === null) throw ApiError.notFound('No record has that id.', { id });",
            "        return { ${2/^(.)/${1:/downcase}/} };",
            "    },",
            "",
            "    /** Removes one; 404 when there is none. */",
            "    remove: (request: RemoveRequest): RemoveResponse => {",
            "        const id = parseId(request.id, 'id');",
            "        if (!remove${2}(id)) throw ApiError.notFound('No record has that id.', { id });",
            "        return { id };",
            "    },",
            "});",
            "",
            "/** The endpoint signatures as a type, for server code that calls this controller through a Suitelet client. */",
            "export type ${TM_FILENAME_BASE/^(.)(.*)Controller$/${1:/upcase}$2/}Endpoints = typeof ${TM_FILENAME_BASE/(.*)Controller$/$1/}Endpoints;",
            "",
            "// The only transport-specific lines, with the header. The declaration creates nothing: it names the script this",
            "// controller is deployed as, and the ids can be changed to whatever the record and deployment are called in NetSuite.",
            "export const post = defineRestlet({",
            "    name: '${TM_FILENAME_BASE/(.*)Controller$/$1/}',",
            "    scriptId: 'customscript_{{prefix}}_${TM_FILENAME_BASE/(?:Controller$)|([A-Z])/${1:+_}${1:/downcase}/g}',",
            "    deployId: 'customdeploy_{{prefix}}_${TM_FILENAME_BASE/(?:Controller$)|([A-Z])/${1:+_}${1:/downcase}/g}',",
            "}, ${TM_FILENAME_BASE/(.*)Controller$/$1/}Endpoints, {",
            "    // Runs before every handler, with the endpoint's name and the request as it came off the wire; throw to refuse.",
            "    // Who may do what is a service's decision, because an endpoint never imports a repository.",
            "    authorize: ({ endpoint, request }) => {",
            "        if ((endpoint === 'update' || endpoint === 'remove') && !isSalesRepOf${2}(parseId(request.id, 'id'))) {",
            "            throw ApiError.forbidden('Only the sales rep may change it.');",
            "        }",
            "    },",
            "});",
            ""
        ]
    },
{{/if}}
{{#if netsuiteApi}}
    "nspControllerSuitelet": {
        "scope": "typescript",
        "prefix": "nspControllerSuitelet",
        "description": "api/src/controllers/<name>Controller.ts as a Suitelet: the Restlet's endpoints plus a CSV download (RawResponse), and `browser: false` to uncomment for a Suitelet only server code calls; keep what the controller needs and delete the rest. Name and ids come from the file name. The service it calls is the domain's, singular (salesOrderService for a sales order), which need not match the controller's name: tab to it. Next: nspObjectSuitelet in netsuite/Objects, npm run generate, then nspRepositorySuitelet or nspHookQuery.",
        "body": [
            "/**",
            " * @NApiVersion 2.1",
            " * @NScriptType Suitelet",
            " * @NModuleScope SameAccount",
            " */",
            "",
            "import { ApiError, defineEndpoints, defineSuitelet, rawResponse, type RawResponse } from '@amerilux/netsuite-api/server';",
            "import { create${2}, get${2}sBy${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}, get${2}, isSalesRepOf${2}, remove${2}, update${2}${4/^(.)/${1:/upcase}/}, type ${2:${TM_FILENAME_BASE/^(.)(.*?)s?Controller$/${1:/upcase}$2/}}Summary } from '../services/${1:${TM_FILENAME_BASE/^(.*?)s?Controller$/$1/}}Service';",
            "",
            "/**",
            " * The ${TM_FILENAME_BASE/(.*)Controller$/$1/} controller: ${5:what it serves}, and why a Suitelet (it runs as another role, or answers a",
            " * file). Each kind of endpoint is here once, with a guard for what comes off the wire, a file download and authorize:",
            " * keep what the controller needs and delete the rest. The shapes are the wire, not",
            " * the record: one request and one response per endpoint, named without the controller's name and all exported, since",
            " * `npm run generate` copies them into the client. An endpoint unpacks the request, calls a service with plain",
            " * arguments and shapes the reply field by field, so a field added to a service's type later does not reach the wire",
            " * unasked.",
            " */",
            "",
            "export interface By${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}Request {",
            "    ${3:customerId}: number;",
            "}",
            "",
            "export interface By${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}Response {",
            "    ${3}: number;",
            "    ${TM_FILENAME_BASE/(.*)Controller$/$1/}: ${2}Summary[];",
            "}",
            "",
            "export interface ByIdRequest {",
            "    id: number;",
            "}",
            "",
            "export interface ByIdResponse {",
            "    ${2/^(.)/${1:/downcase}/}: ${2}Summary;",
            "}",
            "",
            "export interface CreateRequest {",
            "    ${3}: number;",
            "    ${4:memo}: string;",
            "}",
            "",
            "export interface CreateResponse {",
            "    ${2/^(.)/${1:/downcase}/}: ${2}Summary;",
            "}",
            "",
            "export interface UpdateRequest {",
            "    id: number;",
            "    ${4}: string;",
            "}",
            "",
            "export interface UpdateResponse {",
            "    ${2/^(.)/${1:/downcase}/}: ${2}Summary;",
            "}",
            "",
            "export interface RemoveRequest {",
            "    id: number;",
            "}",
            "",
            "export interface RemoveResponse {",
            "    id: number;",
            "}",
            "",
            "export interface CsvBy${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}Request {",
            "    ${3}: number;",
            "}",
            "",
            "/** The wire promises a number; a caller that sends anything else gets a 400, not a query for NaN. */",
            "function parseId(requested: unknown, field: string): number {",
            "    const parsed = typeof requested === 'string' ? Number.parseInt(requested, 10) : requested;",
            "    if (typeof parsed !== 'number' || !Number.isInteger(parsed) || parsed <= 0) {",
            "        throw ApiError.badRequest(`\\${field} must be a positive whole number.`, { [field]: requested });",
            "    }",
            "    return parsed;",
            "}",
            "",
            "/** One CSV cell, quoted when it holds a comma, a quote or a line break. */",
            "function buildCsvCell(value: string | number | null): string {",
            "    const text = value === null ? '' : String(value);",
            "    return /[\",\\r\\n]/.test(text) ? `\"\\${text.replace(/\"/g, '\"\"')}\"` : text;",
            "}",
            "",
            "/** The wire promises text; anything else is a 400. */",
            "function parse${4/^(.)/${1:/upcase}/}(requested: unknown): string {",
            "    if (typeof requested !== 'string') throw ApiError.badRequest('${4} must be text.', { ${4}: requested });",
            "    return requested;",
            "}",
            "",
            "export const ${TM_FILENAME_BASE/(.*)Controller$/$1/}Endpoints = defineEndpoints({",
            "    /** Every one for the ${3/^(.)(.*?)(Id)?$/${1:/downcase}$2/}; 400 for an id that is not a positive whole number. */",
            "    by${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}: (request: By${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}Request): By${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}Response => {",
            "        const ${3} = parseId(request.${3}, '${3}');",
            "        return { ${3}, ${TM_FILENAME_BASE/(.*)Controller$/$1/}: get${2}sBy${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}(${3}) };",
            "    },",
            "",
            "    /** One by its id; 404 when there is none. */",
            "    byId: (request: ByIdRequest): ByIdResponse => {",
            "        const id = parseId(request.id, 'id');",
            "        const ${2/^(.)/${1:/downcase}/} = get${2}(id);",
            "        // \"None\" is the service's answer; which HTTP status that is belongs to the wire, so here.",
            "        if (${2/^(.)/${1:/downcase}/} === null) throw ApiError.notFound('No record has that id.', { id });",
            "        return { ${2/^(.)/${1:/downcase}/} };",
            "    },",
            "",
            "    /** Creates one and answers it with its new id. */",
            "    create: (request: CreateRequest): CreateResponse => {",
            "        const ${3} = parseId(request.${3}, '${3}');",
            "        return { ${2/^(.)/${1:/downcase}/}: create${2}(${3}, parse${4/^(.)/${1:/upcase}/}(request.${4})) };",
            "    },",
            "",
            "    /** Replaces the ${4}; 404 when there is no such record. */",
            "    update: (request: UpdateRequest): UpdateResponse => {",
            "        const id = parseId(request.id, 'id');",
            "        const ${2/^(.)/${1:/downcase}/} = update${2}${4/^(.)/${1:/upcase}/}(id, parse${4/^(.)/${1:/upcase}/}(request.${4}));",
            "        if (${2/^(.)/${1:/downcase}/} === null) throw ApiError.notFound('No record has that id.', { id });",
            "        return { ${2/^(.)/${1:/downcase}/} };",
            "    },",
            "",
            "    /** Removes one; 404 when there is none. */",
            "    remove: (request: RemoveRequest): RemoveResponse => {",
            "        const id = parseId(request.id, 'id');",
            "        if (!remove${2}(id)) throw ApiError.notFound('No record has that id.', { id });",
            "        return { id };",
            "    },",
            "",
            "    /**",
            "     * A file the browser downloads, which only a Suitelet can answer. The return type is written exactly `RawResponse`:",
            "     * the generator reads it, and the generated client resolves the call to a Blob. rawResponse({ file, inline }) answers",
            "     * an N/file file instead, read in a repository.",
            "     */",
            "    csvBy${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}: (request: CsvBy${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}Request): RawResponse => {",
            "        const ${3} = parseId(request.${3}, '${3}');",
            "        const rows = get${2}sBy${3/^(.)(.*?)(Id)?$/${1:/upcase}$2/}(${3}).map((${2/^(.)/${1:/downcase}/}) => [${2/^(.)/${1:/downcase}/}.id, ${2/^(.)/${1:/downcase}/}.${4}].map(buildCsvCell).join(','));",
            "        return rawResponse({ contentType: 'text/csv', body: ['Id,${4/^(.)/${1:/upcase}/}', ...rows].join('\\r\\n'), fileName: `${TM_FILENAME_BASE/(.*)Controller$/$1/}-\\${${3}}.csv` });",
            "    },",
            "});",
            "",
            "/** What a Suitelet client of this script is built from: `createSuiteletClient<${TM_FILENAME_BASE/^(.)(.*)Controller$/${1:/upcase}$2/}Endpoints>(scripts.${TM_FILENAME_BASE/(.*)Controller$/$1/})`. */",
            "export type ${TM_FILENAME_BASE/^(.)(.*)Controller$/${1:/upcase}$2/}Endpoints = typeof ${TM_FILENAME_BASE/(.*)Controller$/$1/}Endpoints;",
            "",
            "// The only transport-specific lines, with the header. The declaration creates nothing: it names the script this",
            "// controller is deployed as, and the ids can be changed to whatever the record and deployment are called in NetSuite.",
            "export const onRequest = defineSuitelet({",
            "    name: '${TM_FILENAME_BASE/(.*)Controller$/$1/}',",
            "    scriptId: 'customscript_{{prefix}}_${TM_FILENAME_BASE/(?:Controller$)|([A-Z])/${1:+_}${1:/downcase}/g}',",
            "    deployId: 'customdeploy_{{prefix}}_${TM_FILENAME_BASE/(?:Controller$)|([A-Z])/${1:+_}${1:/downcase}/g}',",
            "    // browser: false,   only server code calls it (a repository's Suitelet client): npm run generate then writes its types and no client",
            "}, ${TM_FILENAME_BASE/(.*)Controller$/$1/}Endpoints, {",
            "    // Runs before every handler, with the endpoint's name and the request as it came off the wire; throw to refuse.",
            "    // A Suitelet that runs as another role decides here who may ask, because its role no longer says anything about",
            "    // the caller. Who may do what is a service's decision, because an endpoint never imports a repository.",
            "    authorize: ({ endpoint, request }) => {",
            "        if ((endpoint === 'update' || endpoint === 'remove') && !isSalesRepOf${2}(parseId(request.id, 'id'))) {",
            "            throw ApiError.forbidden('Only the sales rep may change it.');",
            "        }",
            "    },",
            "});",
            ""
        ]
    },
{{/if}}
{{#if netsuiteApi}}
    "nspJob": {
        "scope": "typescript",
        "prefix": "nspJob",
        "description": "api/src/jobs/<name>/<name>.ts: the file NetSuite loads for a job, exporting all four stages; a job without a reduce stage deletes that line. The job's ids are written by hand in netsuite.ts, under `jobs` (how-to-use/jobs/map-reduce-job.md). Next: nspJobContract, then nspJobGetInputData, nspJobMap, nspJobReduce, nspJobSummarize and nspJobStart in the same folder, nspObjectMapReduce in netsuite/Objects, then npm run generate.",
        "body": [
            "/**",
            " * @NApiVersion 2.1",
            " * @NScriptType MapReduceScript",
            " * @NModuleScope SameAccount",
            " */",
            "",
            "/**",
            " * The ${TM_FILENAME_BASE} job: ${1:what a run of it does}.",
            " *",
            " * This is the file NetSuite loads: it says which stages there are, and each stage file beside it holds what that",
            " * stage does. The shapes the run carries are in contract.ts, beside them. Every stage is exported here: a job",
            " * without a reduce stage deletes that line and reduce.ts, and summarize.ts then reads what map wrote. Export",
            " * summarize always: the run is closed there. The job's ids are in netsuite.ts, under `jobs`. Nothing imports",
            " * this file.",
            " */",
            "",
            "export { getInputData } from './getInputData';",
            "export { map } from './map';",
            "export { reduce } from './reduce';",
            "export { summarize } from './summarize';",
            ""
        ]
    },
{{/if}}
{{#if netsuiteApi}}
    "nspJobContract": {
        "scope": "typescript",
        "prefix": "nspJobContract",
        "description": "api/src/jobs/<job>/contract.ts: every shape a run of the job carries, hop by hop, in one place. Every stage imports its two types from here, so two stages naming the same value name the one declaration. A job without a reduce stage deletes the tally and has summarize read the outcome.",
        "body": [
            "/**",
            " * What a run of this job carries, hop by hop: what it is started with, what the work is made of, what map writes,",
            " * what reduce leaves for summarize, and what the run leaves behind. Every stage imports its two types from here, so",
            " * the whole chain reads in one place, and two stages naming the same value name the one declaration: TypeScript",
            " * does not compare one stage file's claims against another's, so this file is what keeps them together.",
            " * `npm run generate` copies what the result reaches into the browser's module; everything else stays on the server.",
            " * A job without a reduce stage deletes ${8} and has summarize read ${6}.",
            " */",
            "",
            "/** What a run of this job is asked to do; whatever starts a run builds this. */",
            "export interface ${1:WorkRequest} {",
            "    ${2:olderThanDays}: ${3:number};",
            "}",
            "",
            "/** One piece of the work: what getInputData answers and the map stage is handed. */",
            "export interface ${4:WorkItem} {",
            "    ${5:orderId}: number;",
            "}",
            "",
            "/** What the map stage writes per item, and what reduce gathers under one key. */",
            "export interface ${6:WorkOutcome} {",
            "    ${5}: number;",
            "    ${7:closed}: boolean;",
            "}",
            "",
            "/** What one key comes to: what the reduce stage writes, and what summarize gathers. */",
            "export interface ${8:WorkTally} {",
            "    key: string;",
            "    ${9:handled}: number;",
            "}",
            "",
            "/** What a finished run leaves behind; the page reads it as jobs.<name>.Result, so no Date and no class. */",
            "export interface ${10:WorkResult} {",
            "    ${9}: number;",
            "    failed: number;",
            "    ${11:tallies}: ${8}[];",
            "}",
            ""
        ]
    },
{{/if}}
{{#if netsuiteApi}}
    "nspJobGetInputData": {
        "scope": "typescript",
        "prefix": "nspJobGetInputData",
        "description": "api/src/jobs/<job>/getInputData.ts: the stage that answers the work. jobGetInputData opens the run and hands it what it was started with; the generator reads the run's input from the first type. Its shapes come from contract.ts (nspJobContract).",
        "body": [
            "import { jobs } from '../../../../netsuite';",
            "import { jobGetInputData } from '../../repositories/jobRunRepository';",
            "import { ${1:getWork} } from '../../${2|services,repositories|}/${3:subject}${4|Service,Repository|}';",
            "import type { ${5:WorkItem}, ${6:WorkRequest} } from './contract';",
            "",
            "/**",
            " * ${7:What the work is, and in what order}. The two types are the stage's claim: a run is started with a ${6}, and",
            " * the work is a list of ${5}; `npm run generate` reads the first as the run's input. The builder opens the run first,",
            " * so `input` is what it was started with, already parsed off the run record. The answer is an array, one map call per",
            " * item, or an object whose keys become the map keys. The callback's second parameter carries `runId`, for work that",
            " * stamps records with its run.",
            " */",
            "export const getInputData = jobGetInputData<${6}, ${5}>(jobs.${8:closeOldOrders}, (input) =>",
            "    ${1}(input.${9:olderThanDays}).map((${10:orderId}) => ({ ${10} })));",
            ""
        ]
    },
{{/if}}
{{#if netsuiteApi}}
    "nspJobMap": {
        "scope": "typescript",
        "prefix": "nspJobMap",
        "description": "api/src/jobs/<job>/map.ts: the stage that does one item and writes what it came to. jobMap hands it the item parsed and carries what it writes as JSON. Its shapes come from contract.ts. A test calls it with mapContextFor and reads what it wrote.",
        "body": [
            "import { jobs } from '../../../../netsuite';",
            "import { jobMap } from '../../repositories/jobRunRepository';",
            "import { ${1:updateOneThing} } from '../../${2|services,repositories|}/${3:subject}${4|Service,Repository|}';",
            "import type { ${5:WorkItem}, ${6:WorkOutcome} } from './contract';",
            "",
            "/**",
            " * ${7:What one item does}. `item` arrives parsed, and what `job.write` is given travels on as JSON. The key groups the",
            " * values for the reduce stage (without one, for summarize); it only groups, so anything the next stage needs rides in",
            " * the value. A throw here fails this one item, not the run: NetSuite collects it, and it ends up on the run record",
            " * with its key. `job.runId` is here too, for a stage that stamps a record with its run.",
            " */",
            "export const map = jobMap<${5}, ${6}>(jobs.${8:closeOldOrders}, (item, job) => {",
            "    job.write(String(item.${9:orderId}), { ${9}: item.${9}, ${10:closed}: ${1}(item.${9}) });",
            "});",
            ""
        ]
    },
{{/if}}
{{#if netsuiteApi}}
    "nspJobReduce": {
        "scope": "typescript",
        "prefix": "nspJobReduce",
