{
  "name": "{{appNameKebab}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{description}}",
  "author": "{{author}}",
  "workspaces": [
    "api",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
{{#if codeGeneration}}
    "generate": "{{#if netsuiteRepository}}npm run generate -w api{{#if netsuiteApi}} && {{/if}}{{/if}}{{#if netsuiteApi}}netsuite-api generate{{/if}}",
{{/if}}
    "dev": "{{#if codeGeneration}}npm run generate && {{/if}}npm run dev -w client",
    "typecheck": "{{#if codeGeneration}}npm run generate && {{/if}}npm run typecheck --workspaces",
    "lint": "eslint . && node scripts/checkStructure.mjs",
{{#if netsuiteApi}}
    "add:jobs": "node scripts/addJobs.mjs",
{{/if}}
    "test": "{{#if codeGeneration}}npm run generate && {{/if}}npm test --workspaces --if-present",
    "build": "{{#if codeGeneration}}npm run generate && {{/if}}npm run build -w client && npm run build -w api",
    "deploy:full": "node scripts/deploy.mjs",
    "deploy": "node scripts/deploy.mjs --files-only"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
{{#if probity}}
    "@nizos/probity": "^1.10.0",
{{/if}}
    "@oracle/suitecloud-cli": "3.2.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
