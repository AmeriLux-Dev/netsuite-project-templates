{
  "name": "{{appNameKebab}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{description}}",
  "author": "{{author}}",
  "workspaces": [
    "common",
    "api",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run generate",
    "dev": "npm run dev -w client",
    "generate": "npm run generate -w api",
    "prebuild": "npm run generate",
    "build": "npm run build -w client && npm run build -w api",
    "deploy": "node scripts/deploy.mjs",
    "deploy:files": "node scripts/deploy.mjs --files-only",
    "pretest": "npm run generate",
    "test": "npm test --workspaces --if-present",
    "pretypecheck": "npm run generate",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && node scripts/checkStructure.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
{{#if probity}}
    "@nizos/probity": "^1.10.0",
{{/if}}
    "@oracle/suitecloud-cli": "3.2.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
