# Copy to client/.env (gitignored). Read only by client/server.ts, the local dev proxy.
# None of these carry the Vite client prefix on purpose: Vite inlines prefixed variables into the uploaded bundle.

# Sandbox account id as NetSuite shows it: <id>_SB1 for a sandbox, <id> for production.
NETSUITE_ACCOUNT_ID=1234567_SB1

# OAuth 2.0 integration record using client credentials (machine to machine).
NETSUITE_CLIENT_ID=
NETSUITE_CERTIFICATE_ID=

# Absolute path to the private key (.pem) that matches the certificate. Keep it OUTSIDE the repository.
NETSUITE_PRIVATE_KEY_PATH=

# Signing algorithm of the key: ES256 (EC P-256), PS256 or RS256 (RSA).
NETSUITE_KEY_ALGORITHM=ES256

# Port the proxy listens on; vite.config.ts forwards /api here.
DEV_PROXY_PORT=4000
